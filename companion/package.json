{
  "name": "remindme-companion",
  "productName": "RemindMe Companion",
  "version": "1.0.0",
  "description": "Desktop companion for the RemindMe Chrome extension: shows reminders in always-on-top windows above every application.",
  "main": "src/main.js",
  "license": "MIT",
  "author": "RemindMe",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.remindme.companion",
    "productName": "RemindMe Companion",
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "runAfterFinish": true },
    "mac": { "target": ["dmg"], "icon": "assets/icon.png", "category": "public.app-category.productivity", "extendInfo": { "LSUIElement": true } },
    "linux": { "target": ["AppImage"], "icon": "assets/icon.png", "category": "Utility" }
  }
}
